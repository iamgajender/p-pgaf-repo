async function installPostgres() {

    const deployment = {

        server_ip: document.getElementById("server_ip").value,

        ssh_user: document.getElementById("ssh_user").value,

        ssh_password: document.getElementById("ssh_password").value,

        postgres_version: document.getElementById("postgres_version").value

    };

    const status = document.getElementById("status");

    status.textContent = "Starting deployment...";

    const timer = setInterval(loadDeploymentLog, 2000);
    try {

        const response = await fetch("/install", {

            method: "POST",

            headers: {

                "Content-Type": "application/json"

            },

            body: JSON.stringify(deployment)

        });

        const result = await response.json();
	clearInterval(timer);

        console.log(result);

        //
        // Installation Failed
        //
        if (result.status !== "success") {

            status.innerHTML = `

                <h3 style="color:red;">❌ ${result.message}</h3>

                <pre>${result.stderr || ""}</pre>

            `;

            return;
        }

        //
        // Build Success HTML
        //
        let html = `

            <h3 style="color:green;">
                ✅ ${result.message}
            </h3>

            <hr>

            <h3>Server Information</h3>

            <table class="summary-table">

                <tr>

                    <td><strong>Hostname</strong></td>

                    <td>${result.summary.hostname}</td>

                </tr>

                <tr>

                    <td><strong>PostgreSQL Version</strong></td>

                    <td>${result.summary.postgres_version}</td>

                </tr>

            </table>

            <hr>

            <h3>PostgreSQL Configuration</h3>

            <table class="summary-table">

                <tr>

                    <th>Parameter</th>

                    <th>Value</th>

                </tr>

        `;

        result.summary.settings.forEach(setting => {

            const parts = setting.split("=");

            html += `

                <tr>

                    <td>${parts[0]}</td>

                    <td>${parts[1]}</td>

                </tr>

            `;

        });

        html += "</table>";

        status.innerHTML = html;

    }

    catch (error) {

        console.error(error);

        status.innerHTML = "Unable to reach Backend Server.";

    }

}










async function loadDeploymentLog() {

    try {

        const response = await fetch("/deployment/log");

        const result = await response.json();

        document.getElementById("status").textContent = result.log;

    }

    catch (error) {

        console.error(error);

    }

}
