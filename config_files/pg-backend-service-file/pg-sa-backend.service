[Unit]
Description=PostgreSQL Automation Portal Backend (Gunicorn)
After=network.target

[Service]

User=root
Group=root

WorkingDirectory=/opt/pg_sa/backend

Environment="PATH=/opt/pg_sa/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/opt/pg_sa/backend/venv/bin/gunicorn \
          --workers 3 \
          --bind 0.0.0.0:5000 \
          --timeout 1800 \
          app:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
